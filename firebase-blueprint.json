{
  "entities": {
    "Potluck": {
      "title": "Potluck",
      "description": "A Thanksgiving potluck feast event created by a host.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 128, "minLength": 1 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 128 },
        "ownerEmail": { "type": "string", "maxLength": 128 },
        "eventDate": { "type": "string", "maxLength": 64 },
        "location": { "type": "string", "maxLength": 256 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title"]
    },
    "Dish": {
      "title": "Dish",
      "description": "A potluck item that can be claimed by guests without login.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128, "minLength": 1 },
        "emoji": { "type": "string", "maxLength": 16 },
        "order": { "type": "number" },
        "isCustom": { "type": "boolean" },
        "claimedBy": { "type": "string", "maxLength": 128 },
        "claimedAt": { "type": "string", "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "name", "isCustom"]
    }
  },
  "firestore": {
    "/potlucks/{potluckId}": {
      "schema": "Potluck",
      "description": "Potluck event metadata owned by a Google-authenticated host."
    },
    "/potlucks/{potluckId}/dishes/{dishId}": {
      "schema": "Dish",
      "description": "Dishes claimed by guests or added as custom wildcards."
    }
  }
}
