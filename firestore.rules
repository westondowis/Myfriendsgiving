rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPotluck(data) {
      return data.keys().hasAll(['id', 'title']) &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 128;
    }

    function isValidDish(data) {
      return data.keys().hasAll(['id', 'name']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 128;
    }

    // Potluck event metadata
    match /potlucks/{potluckId} {
      allow get: if isValidId(potluckId);
      allow list: if true;
      allow create: if isValidId(potluckId) && isValidPotluck(request.resource.data);
      allow update: if isValidId(potluckId) && isValidPotluck(request.resource.data);
      allow delete: if isValidId(potluckId) &&
                    request.auth != null &&
                    resource.data.ownerId == request.auth.uid;
    }

    // Dishes within a potluck (read & claimed by guests without login)
    match /potlucks/{potluckId}/dishes/{dishId} {
      allow get, list: if isValidId(potluckId);
      allow create: if isValidId(potluckId) && isValidId(dishId) && isValidDish(request.resource.data);
      allow update: if isValidId(potluckId) && isValidId(dishId) && isValidDish(request.resource.data);
      allow delete: if isValidId(potluckId) && isValidId(dishId) && (
        (request.auth != null && exists(/databases/$(database)/documents/potlucks/$(potluckId)) && get(/databases/$(database)/documents/potlucks/$(potluckId)).data.ownerId == request.auth.uid) ||
        resource.data.isCustom == true
      );
    }
  }
}
