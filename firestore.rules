rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPotluck(data) {
      return data.keys().hasAll(['id', 'title']) &&
        data.keys().hasOnly(['id', 'title', 'ownerId', 'ownerName', 'ownerEmail', 'eventDate', 'location', 'notes', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 128 &&
        (!('ownerId' in data) || (data.ownerId is string && data.ownerId.size() <= 128)) &&
        (!('ownerName' in data) || (data.ownerName is string && data.ownerName.size() <= 128)) &&
        (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 128)) &&
        (!('eventDate' in data) || (data.eventDate is string && data.eventDate.size() <= 64)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 256)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidDish(data) {
      return data.keys().hasAll(['id', 'name', 'isCustom']) &&
        data.keys().hasOnly(['id', 'name', 'emoji', 'order', 'isCustom', 'claimedBy', 'claimedAt', 'notes']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
        data.isCustom is bool &&
        (!('emoji' in data) || (data.emoji is string && data.emoji.size() <= 32)) &&
        (!('order' in data) || data.order is number) &&
        (!('claimedBy' in data) || data.claimedBy == null || (data.claimedBy is string && data.claimedBy.size() <= 128)) &&
        (!('claimedAt' in data) || data.claimedAt == null || (data.claimedAt is string && data.claimedAt.size() <= 64)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    // Potluck event metadata
    match /potlucks/{potluckId} {
      allow get: if isValidId(potluckId);
      allow list: if true;
      allow create: if isValidId(potluckId) && isValidPotluck(request.resource.data);
      allow update: if isValidId(potluckId) && isValidPotluck(request.resource.data);
      allow delete: if isValidId(potluckId) &&
                    request.auth != null &&
                    resource.data.ownerId == request.auth.uid;
    }

    // Dishes within a potluck (read & claimed by guests without login)
    match /potlucks/{potluckId}/dishes/{dishId} {
      allow get, list: if isValidId(potluckId);
      allow create: if isValidId(potluckId) && isValidId(dishId) && isValidDish(request.resource.data);
      allow update: if isValidId(potluckId) && isValidId(dishId) && isValidDish(request.resource.data);
      allow delete: if isValidId(potluckId) && isValidId(dishId) && (
        (request.auth != null && exists(/databases/$(database)/documents/potlucks/$(potluckId)) && get(/databases/$(database)/documents/potlucks/$(potluckId)).data.ownerId == request.auth.uid) ||
        resource.data.isCustom == true
      );
    }
  }
}
